# tools/setup.sh creates .env with fresh local credentials. Existing .env is preserved.
DB_PASSWORD=
Jwt__Secret=
Jwt__Issuer=Starter
Jwt__Audience=Starter
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5001
# Native connection string, use shell quotes around the value.
ConnectionStrings__DefaultConnection='Host=127.0.0.1;Port=5432;Database=starter;Username=starter;Password=YOUR_LOCAL_DB_PASSWORD'
