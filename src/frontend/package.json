{
  "name": "starter-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "generate:clients": "node scripts/generate-nswag-clients.mjs",
    "generate": "npm run generate:openapi && npm run generate:clients"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "26.1.2",
    "@vitejs/plugin-react": "6.0.4",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "nswag": "14.7.1"
  }
}
